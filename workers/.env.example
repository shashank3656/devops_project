# Copy to workers/.env on the machine that runs the worker.
# Process environment (systemd, Docker, Kubernetes) wins over this file.
# Never put tokens or HMAC keys on the command line or in tickets.

OPSTRELLIS_API_URL=http://localhost:8080
MONITORING_SOURCE=grafana
MONITORING_CONNECTOR_ID=
MONITORING_SERVICE_ID=
MONITORING_SERVICE_ENVIRONMENT=production

# HMAC used to push mapped counts to OpsTrellis.
# Store PRIVATE_SAMPLE_SECRET as secret_ref on a private connector.
PRIVATE_SAMPLE_SECRET_REF=PRIVATE_SAMPLE_SECRET
PRIVATE_SAMPLE_SECRET=

# Grafana. Store GRAFANA_TOKEN as secret_ref on a Grafana connector.
GRAFANA_TOKEN=
GRAFANA_BASE_URL=http://127.0.0.1:3000
GRAFANA_DATASOURCE_UID=
GRAFANA_QUERY=
GRAFANA_QUERY_URL=
GRAFANA_ALLOW_HOST=

# Splunk. Store SPLUNK_TOKEN as secret_ref on a Splunk connector.
SPLUNK_TOKEN=
SPLUNK_BASE_URL=http://127.0.0.1:8089
SPLUNK_QUERY=
SPLUNK_QUERY_URL=
SPLUNK_ALLOW_HOST=

# Global Vulnerabilities & Patches worker.
# Two modes share this file. Fill only the block you are running.
# Never put tokens on the command line or in tickets. Copy this file to workers/.env.

# --- Private outbound agent: python3 workers/vuln_agent.py ---
# One-time enroll. Paste the ost_enroll_ token from Security → Agents & sources (shown once).
# After the first successful enroll you can clear this; identity is stored in workers/.agent_token.
VULN_BOOTSTRAP_TOKEN=
# Optional override of the enrolled ost_agent_ identity. Leave empty unless you are injecting
# an already-enrolled token from a secret store instead of workers/.agent_token.
VULN_AGENT_TOKEN=
# Absolute path to a local checkout the agent can read lockfiles from. Required unless GITHUB_TOKEN
# is set on this worker for hosted Contents reads. Images are not pulled.
VULN_REPO_DIR=
# Seconds between claim/heartbeat polls. 15 is fine.
VULN_POLL_SECONDS=15

# --- CI inventory upload: python3 workers/vuln_agent.py --ci ---
# Registered repository id from Security → Configuration (not owner/name).
VULN_REPOSITORY_ID=
# Immutable commit SHA being uploaded. Optional if VULN_REPO_DIR is a git checkout (HEAD is used).
VULN_COMMIT_SHA=
# Optional path to a CycloneDX or SPDX JSON file. If empty, the agent reads lockfiles from VULN_REPO_DIR.
VULN_SBOM_FILE=
# Portal session or CI token with access to that repository. Required for --ci. Not the agent token.
VULN_PORTAL_TOKEN=
