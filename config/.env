# =============================================================================
# Backend required env (API will not start or will fail closed without these)
# =============================================================================
# Required always:
#   DATABASE_URL          preferred DB DSN
#     or DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME
#   SESSION_SECRET        signs login JWTs (JWT_SECRET is an accepted alias)
#   API_KEY_HASH_SECRET   peppers API-key hashes
#   FRONTEND_URL          user portal URL (CORS + password-reset links)
#   ADMIN_FRONTEND_URL    admin portal URL (CORS)
#   DEVOPS_FRONTEND_URL   DevOps portal URL (CORS)
#
# Required when APP_ENV=production or prod:
#   SESSION_SECRET (or JWT_SECRET)
#   API_KEY_HASH_SECRET (or API_KEY_PEPPER)
#
# Required only if you use that feature:
#   ADMIN_SECRET + ADMIN_BREAKGLASS_USER_ID   X-Admin-Secret break-glass
#   GITHUB_OWNER, GITHUB_REPO, GITHUB_TOKEN   GitHub PRs
#   REDIS_ADDR or REDIS_URL                   cache / job queue
#   SMTP_*                                    email
#   SLACK_WEBHOOK_URL                         Slack
#
# Frontend only (not backend boot):
#   NEXT_PUBLIC_API_URL
# =============================================================================

# -----------------------------------------------------------------------------
# Database (required for backend)
# -----------------------------------------------------------------------------
# DB_HOST=postgres
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=infra_portal

# Database Configuration for DEV
DATABASE_URL="postgresql://postgres.jkvrxhwoxtrkzvzogixi:ezn3XgTBn8EoD2oB@aws-1-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=verify-full"
DB_HOST=aws-1-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.jkvrxhwoxtrkzvzogixi
DB_PASSWORD=ezn3XgTBn8EoD2oB
DB_NAME=postgres
DB_SSLMODE=verify-full
DB_SSLROOTCERT=./prod-ca-2021.crt

# Redis (Railway production). Local Compose overrides REDIS_ADDR to redis:6379.
REDIS_ADDR=redis-production-75cbc.up.railway.app:6379
REDIS_URL=redis://redis-production-75cbc.up.railway.app:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL_SECONDS=90
REDIS_QUEUE_NAME=infra:jobs
REDIS_JOB_POLL_TIMEOUT_SECONDS=5

# GitHub Configuration
# GITHUB_OWNER can be your GitHub username (personal account) or organization name
# Example: GITHUB_OWNER=your-username or GITHUB_OWNER=your-org-name
#GITHUB_OWNER=ngsops
GITHUB_OWNER=shashank3656
GITHUB_REPO=Application_Onboarding
# GitHub Personal Access Token (PAT)
# Create one at: https://github.com/settings/tokens
# Required permissions: repo (full control of private repositories)
GITHUB_TOKEN=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
BASE_BRANCH=main

# Frontend Configuration
#NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=https://backend-api-production-ed.up.railway.app
# -----------------------------------------------------------------------------
# SMTP / Email (optional – for notification emails)
# -----------------------------------------------------------------------------
# Leave unset to disable email. When set, notification emails (approve/reject/PR created) are sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=devops3656@gmail.com
SMTP_PASSWORD=avhbdsfwpllsgogm
SMTP_FROM=devops3656@gmail.com
# TLS: set to "true" for STARTTLS (e.g. port 587), "false" for plain
SMTP_USE_TLS=true

# -----------------------------------------------------------------------------
# Session and API security (required for backend)
# -----------------------------------------------------------------------------
APP_ENV=local
# Required for backend: signs session JWTs. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=_4E9zfAWR-cnehDlCSKTwJmImtGMYNdxdKmaZCocY-pfJsLXaUj08VfLhsSzPbjk
# Required for backend: peppers hashed API keys. Generate the same way.
API_KEY_HASH_SECRET=wmk-TKX1-2curc4NxZ4ioe8k12t6utCHQi2Ftf8keHOexHlOwlL7nLALqoBO30HW
# Required only for X-Admin-Secret break-glass, together with ADMIN_BREAKGLASS_USER_ID.
ADMIN_SECRET=hIOesu2jYp-1BYqURN_wimSZlREBnQUoit_N8EiLnfoH1GAouFTstB9W9CrelFPD
ADMIN_BREAKGLASS_USER_ID=1
ALLOW_TEST_OTP=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,https://devopsproject-frontend-production.up.railway.app,https://devopsproject-admin-frontend-production.up.railway.app,https://devopsproject-devops-frontend-production.up.railway.app
# Session timeout in minutes (default: 1440 = 24h). Shorter values improve security.
SESSION_TIMEOUT_MINUTES=60

# Query/runtime guardrails
DB_QUERY_TIMEOUT_SECONDS=5
DB_TX_TIMEOUT_SECONDS=30
DB_SLOW_QUERY_MS=750
REQUEST_LOG_SLOW_MS=500
DB_CONN_MAX_LIFETIME_MINUTES=2
DB_CONN_MAX_IDLE_TIME_MINUTES=1
DB_MAX_OPEN_CONNS=15
DB_MAX_IDLE_CONNS=3

# Base URL for user frontend (for password reset links in email)
FRONTEND_URL=https://devopsproject-frontend-production.up.railway.app
ADMIN_FRONTEND_URL=https://devopsproject-admin-frontend-production.up.railway.app
DEVOPS_FRONTEND_URL=https://devopsproject-devops-frontend-production.up.railway.app

# Slack incoming webhook URL for notifications (approved, rejected, PR created)
