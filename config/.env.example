# GitHub Configuration
# GITHUB_OWNER can be your GitHub username (personal account) or organization name
# Example: GITHUB_OWNER=your-username or GITHUB_OWNER=your-org-name
# REQUIRED: Set your GitHub username or organization name
GITHUB_OWNER=shashank3656
# REQUIRED: Set your GitHub repository name
GITHUB_REPO=Application_Onboarding
# GitHub Personal Access Token (PAT)
# Create one at: https://github.com/settings/tokens
# Required permissions: repo (full control of private repositories)
# REQUIRED: Set your GitHub Personal Access Token
GITHUB_TOKEN=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
# Base branch for creating PRs (default: main)
BASE_BRANCH=main

# Frontend Configuration
# Backend API URL - Change this based on your deployment:
#   Local: http://localhost:8080
#   EC2: http://your-ec2-ip-or-domain:8080
#   Docker (same host): http://localhost:8080
#   Docker (different host): http://host-ip:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=infra_portal
