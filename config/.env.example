# =============================================================================
# DevOps Tool / InfraGate - Environment variables
# Copy to .env and set real values. Never commit .env with real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (required for backend)
# -----------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=infra_portal
# Optional explicit postgres bootstrap variables for docker-compose postgres.
# If omitted, scripts/sync-env.sh mirrors DB_USER/DB_PASSWORD/DB_NAME into these.
# POSTGRES_USER=infra_app
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=infra_portal
# Optional full DSN override instead of DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME
# DATABASE_URL=postgres://infra_app:change-me@postgres:5432/infra_portal?sslmode=disable

# -----------------------------------------------------------------------------
# Redis / Reliability (recommended)
# -----------------------------------------------------------------------------
# Redis is used for cached dashboard data, onboarding progress, notification
# counters, and the lightweight background job queue for email/webhook delivery.
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL_SECONDS=90
REDIS_QUEUE_NAME=infra:jobs
REDIS_JOB_POLL_TIMEOUT_SECONDS=5

# Query/runtime guardrails
DB_QUERY_TIMEOUT_SECONDS=5
DB_SLOW_QUERY_MS=750
REQUEST_LOG_SLOW_MS=500

# -----------------------------------------------------------------------------
# GitHub (required for PR creation)
# -----------------------------------------------------------------------------
# Your GitHub username or organization name
GITHUB_OWNER=ngsops
# Repository name
GITHUB_REPO=your-repo
# Personal Access Token: https://github.com/settings/tokens (repo scope)
GITHUB_TOKEN=your-github-token
# Base branch for PRs (default: main)
BASE_BRANCH=main

# -----------------------------------------------------------------------------
# Session (optional)
# -----------------------------------------------------------------------------
# Session timeout in minutes (default: 1440 = 24h). Shorter values improve security.
# SESSION_TIMEOUT_MINUTES=60

# -----------------------------------------------------------------------------
# Admin API & default admin (optional but recommended)
# -----------------------------------------------------------------------------
# Required for admin login from admin frontend. If set, X-Admin-Secret header
# can also be used for PATCH /api/users/:id/role and /verify
ADMIN_SECRET=change-me-admin-secret

# Default admin user created on first start if no admin exists
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-admin-password
DEFAULT_ADMIN_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# Frontend (used by Next.js apps)
# -----------------------------------------------------------------------------
# Backend API URL. Examples:
#   Local: http://localhost:8080
#   Docker same host: http://localhost:8080
#   EC2 / server: http://your-host:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# SMTP / Email (optional – for notification emails)
# -----------------------------------------------------------------------------
# Leave unset to disable email. When set, notification emails (approve/reject/PR created) are sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# TLS: set to "true" for STARTTLS (e.g. port 587), "false" for plain
SMTP_USE_TLS=true

# -----------------------------------------------------------------------------
# Keycloak / SSO (optional)
# -----------------------------------------------------------------------------
# Run Keycloak from docker-compose on host port 8081.
# Example realm endpoint:
# http://localhost:8081/realms/infra/protocol/openid-connect/auth
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

# Backend SSO fallback URLs (used if admin has not saved sso_login_url in UI)
SSO_LOGIN_URL=http://localhost:8081/realms/infra/protocol/openid-connect/auth
KEYCLOAK_SSO_LOGIN_URL=http://localhost:8081/realms/infra/protocol/openid-connect/auth

# Optional payload for backend SSO sync endpoint
# KEYCLOAK_DIRECTORY_USERS_JSON=[{"external_id":"abc","username":"jane","email":"jane@example.com","user_type":"portal_user","role":"viewer"}]

# Optional shared secret for POST /api/auth/sso-login (X-SSO-Auth-Secret)
# SSO_AUTH_SHARED_SECRET=change-me

# -----------------------------------------------------------------------------
# CI/CD & Integrations
# -----------------------------------------------------------------------------
# Secret for CI to authenticate when POSTing pipeline status to /api/webhooks/ci
# CI_WEBHOOK_SECRET=your-ci-secret

# Slack incoming webhook URL for notifications (approved, rejected, PR created)
SLACK_WEBHOOK_URL=

# Microsoft Teams incoming webhook URL (approved, rejected, PR created, SLA breach)
# TEAMS_WEBHOOK_URL=https://xxx.webhook.office.com/...

# -----------------------------------------------------------------------------
# Phase 5 & 6 - Optional
# -----------------------------------------------------------------------------
# Base URL for user frontend (required for password reset links in email)
# Must match where users access the portal. Examples:
#   Local: http://localhost:3000
#   Deployed: http://YOUR_SERVER_IP:3000 or https://your-domain.com
FRONTEND_URL=http://localhost:3000

# Base URL for DevOps frontend (required for DevOps password reset links in email)
# Must match where DevOps users access the portal. Examples:
#   Local: http://localhost:3002
#   Deployed: http://YOUR_SERVER_IP:3002 or https://devops.your-domain.com
DEVOPS_FRONTEND_URL=http://localhost:3002

# URL to POST when request is approved (approved or pr_created event)
# WEBHOOK_APPROVE_URL=https://your-webhook.example.com/approved

# Comma-separated IPs allowed for admin API (empty = allow all)
# IP_ALLOWLIST=127.0.0.1,::1
