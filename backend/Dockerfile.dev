# Development image. Build from repository root:
#   docker build -f backend/Dockerfile.dev .
FROM golang:1.25-alpine

WORKDIR /app

# hadolint ignore=DL3018
RUN apk --no-cache upgrade && apk add --no-cache git ca-certificates

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/*.go ./
COPY config/ /app/config/
COPY prod-ca-2021.crt /app/certs/prod-ca-2021.crt

ENV PORT=8080 \
    DB_SSLROOTCERT=/app/certs/prod-ca-2021.crt

EXPOSE 8080
CMD ["go", "run", "-mod=mod", "."]
