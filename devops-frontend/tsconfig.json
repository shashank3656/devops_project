{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "*": ["./*"],
      "@infragate/ui": ["./shared-ui/index.ts", "../shared-ui/index.ts"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"],
      "next/link": ["./node_modules/next/link.d.ts"],
      "next/router": ["./node_modules/next/router.d.ts"]
    }
  },
  "include": ["next-env.d.ts", "css.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
